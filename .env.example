# Copy this file to `.env` and fill in the values.

# --- Option 1: Google AI Studio (simplest, just an API key) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-google-ai-studio-api-key

# --- Option 2: Vertex AI (uncomment and remove the API key block above) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Tavily (web search for live news / sentiment) ---
# Get a free key at https://app.tavily.com/
TAVILY_API_KEY=your-tavily-api-key

# --- Groq (fast LLM inference; powers the agent itself) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# --- Twelve Data (fundamentals + valuation cross-check) ---
# Get a key at https://twelvedata.com/account/api-keys
# NOTE: `/quote` is free (Basic plan). `/profile` requires Grow and
# `/statistics` requires Pro — on the free Basic plan, those two will
# return errors and only quote-derived fields populate.
TWELVE_API_KEY=your-twelvedata-api-key

# Cache TTL (seconds) for Twelve Data lookups to avoid burning credits
# on repeat queries for the same symbol. Default 300 (5 min). Set to 0
# to disable caching entirely.
TWELVE_DATA_CACHE_TTL=300
